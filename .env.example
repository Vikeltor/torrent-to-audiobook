# Скопируйте этот файл как .env и заполните своими данными
# cp .env.example .env

# Секретный путь для ссылок на скачивание (придумайте свой, например: openssl rand -hex 8)
SECRET=your_secret_path_here

# Токен вашего Telegram-бота (получить у @BotFather)
TG_TOKEN=your_telegram_bot_token_here

# Публичный IP и порт вашего сервера
PUBLIC_HOST=192.168.1.1:8080
